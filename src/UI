function fbar(){var n=(S.meal!=='All'?1:0)+S.diets.size+(S.time!=='Any'?1:0)+(S.diff!=='Any'?1:0)+S.meats.size,o=S.fopen;return '<div class="fwrap"><button class="fbtn" data-act="fopen" aria-expanded="'+o+'"><span>Filters'+(n?'<span class="cnt">'+n+'</span>':'')+'</span><span class="chev'+(o?' up':'')+'">'+I('down')+'</span></button>'+(o?'<div class="fpanel">'+frow('Meal',MEALS,'meal',function(f){return S.meal===f})+frow('Time to make',['Any'].concat(Object.keys(TIMES)),'time',function(f){return S.time===f})+frow('Difficulty',['Any'].concat(DIFFS),'diff',function(f){return S.diff===f})+frow('Meat',MEATS,'meat',function(f){return S.meats.has(f)})+frow('Diet',DIETS,'diet',function(f){return S.diets.has(f)})+frow('Allergy-free',ALLERGY,'diet',function(f){return S.diets.has(f)})+(n?'<button class="ghost" data-act="clr">Clear filters</button>':'')+'</div>':'')+'</div>'}
function tagRow(r){var t=r.meal.map(function(m){return '<span class="tag m">'+e(m)+'</span>'}).concat(r.meats.concat(r.tags).map(function(g){return '<span class="tag">'+e(g)+'</span>'}));return t.length?'<div class="chips tags">'+t.join('')+'</div>':''}
function det(k,t,b){return '<details class="sec" data-k="'+k+'"'+(S.dopen.has(k)?' open':'')+'><summary>'+t+'</summary>'+b+'</details>'}
function secs(r){return det('i'+r.id,'Ingredients (serves '+r.serves+')','<ul class="il">'+r.ing.map(function(g){return '<li>'+(g[0]?fq(g[0])+' '+e(g[1])+' ':'')+e(g[2])+'</li>'}).join('')+'</ul>')+det('s'+r.id,'Instructions','<ol class="steps">'+r.steps.map(function(s){return '<li>'+e(s)+'</li>'}).join('')+'</ol>')+det('c'+r.id,'Comments ('+r.comments.length+')','<div class="cm">'+r.comments.map(function(c){return '<p><b>'+e(c.u)+'</b>'+e(c.t)+'</p>'}).join('')+'<div class="cin"><input class="inp" id="ci'+r.id+'" data-cin="'+r.id+'" placeholder="Add a comment" aria-label="Add a comment"><button class="btn" data-act="cpost" data-id="'+r.id+'">Post</button></div></div>')}
function cchip(k,v){var on=k==='d'?S.cd===v:(k==='m'?S.cm:k==='x'?S.cx:S.ct).has(v);return '<button type="button" class="f '+(on?'on':'')+'" data-act="ctog" data-k="'+k+'" data-id="'+v+'" aria-pressed="'+on+'">'+v+'</button>'}
function reel(r){var l=S.liked.has(r.id),s=S.saved.has(r.id);return '<section class="reel" style="background:linear-gradient(160deg,'+r.g[0]+','+r.g[1]+')"><div class="rem" aria-hidden="true">'+r.emoji+'</div><div class="scrim"></div><div class="rrail"><button data-act="like" data-id="'+r.id+'" class="'+(l?'on-like':'')+'" aria-pressed="'+l+'" aria-label="Like">'+I('heart',l)+'<span>'+(r.likes+(l?1:0)).toLocaleString()+'</span></button><button data-act="open" data-id="'+r.id+'" aria-label="Open recipe">'+I('chat')+'<span>Recipe</span></button><button data-act="save" data-id="'+r.id+'" class="'+(s?'on-like':'')+'" aria-pressed="'+s+'" aria-label="Save to cookbook">'+I('save',s)+'<span>'+(s?'Saved':'Save')+'</span></button></div><div class="rinfo"><div class="chead" style="padding:0 0 8px;color:#fff"><span class="av">'+e(r.user[0].toUpperCase())+'</span>'+e(r.user)+'</div><b>'+e(r.title)+'</b><p>'+e(r.cap)+'</p><button class="rbtn" data-act="open" data-id="'+r.id+'">View recipe</button></div></section>'}
function ptabs(){return '<div class="ptabs" role="tablist">'+[['posts','Posts'],['book','Cookbook']].map(function(t){var on=S.ptab===t[0];return '<button role="tab" aria-selected="'+on+'" class="'+(on?'on':'')+'" data-act="ptab" data-id="'+t[0]+'">'+t[1]+'</button>'}).join('')+'</div>'}
function last(u){var m=(MSG[u]||[]).slice(-1)[0];return m?(m.rid?'Shared a recipe':(m.me?'You: ':'')+m.t):'No messages yet'}
function inbox(){return '<div class="sheet" style="padding-bottom:20px"><div class="sh"><button class="bk" data-act="dmclose" aria-label="Close messages">'+I('back')+'</button><h2>Messages</h2></div>'+PEOPLE.map(function(u){return '<button class="prow" data-act="chat" data-id="'+u+'"><span class="av">'+e(u[0].toUpperCase())+'</span><span class="t"><b>'+e(u)+'</b><small>'+e(last(u))+'</small></span>'+(S.unread.has(u)?'<i class="dot" aria-label="Unread"></i>':'')+'</button>'}).join('')+'</div>'}
function chat(u){return '<div class="sheet"><div class="sh"><button class="bk" data-act="inbox" aria-label="Back to messages">'+I('back')+'</button><h2>'+e(u)+'</h2></div><div class="msgs">'+(MSG[u]||[]).map(function(m){if(m.rid){var r=find(m.rid);return '<button class="rcard '+(m.me?'me':'')+'" data-act="open" data-id="'+r.id+'"><span class="th" style="background:linear-gradient(135deg,'+r.g[0]+','+r.g[1]+')">'+r.emoji+'</span><span><b>'+e(r.title)+'</b><small style="display:block;color:var(--mute)">Tap to view recipe</small></span></button>'}return '<div class="bub '+(m.me?'me':'in')+'">'+e(m.t)+'</div>'}).join('')+'</div><div class="composer"><input class="inp" id="mi" placeholder="Message" aria-label="Message"><button class="btn" data-act="msend" data-id="'+e(u)+'">Send</button></div></div>'}
function shareSheet(){var r=find(S.share);return '<div class="bd" data-act="shclose"></div><div class="bsheet" role="dialog" aria-label="Send recipe"><h3>Send recipe</h3><p>'+e(r.title)+'</p>'+PEOPLE.map(function(u){var d=S.sent.has(r.id+'|'+u);return '<div class="prow"><span class="av">'+e(u[0].toUpperCase())+'</span><span class="t"><b>'+e(u)+'</b></span><button class="sbtn '+(d?'done':'')+'" data-act="sendto" data-id="'+e(u)+'">'+(d?'Sent':'Send')+'</button></div>'}).join('')+'<div style="padding:12px 16px 0"><button class="ghost" style="width:100%" data-act="shclose">Done</button></div></div>'}
function feed(){var l=R.filter(match);return l.length?l.map(card).join(''):'<div class="empty"><h3>No recipes match</h3><p>Try removing a filter.</p><button class="ghost" style="margin-top:14px" data-act="clr">Clear filters</button></div>'}
function grid(list,msg){return list.length?'<div class="grid">'+list.map(function(r){return ph(r,'sq')}).join('')+'</div>':'<div class="empty"><h3>'+msg[0]+'</h3><p>'+msg[1]+'</p></div>'}
var V={
home:function(){return '<div class="stories">'+R.map(function(r){return '<button class="story" data-act="open" data-id="'+r.id+'"><div class="ring"><span>'+r.emoji+'</span></div>'+e(r.user.split('.')[0])+'</button>'}).join('')+'</div>'+fbar()+'<div id="grid">'+feed()+'</div>'},
explore:function(){return '<input class="search" id="q" type="search" placeholder="Search recipes" aria-label="Search recipes" value="'+e(S.q)+'">'+fbar()+'<div id="grid">'+exGrid()+'</div>'},
create:function(){return '<div class="body"><h2 style="font-size:26px">New recipe</h2><label for="t">Title</label><input class="inp" id="t" placeholder="Name your dish"><label for="m">Time in minutes</label><input class="inp" id="m" type="number" inputmode="numeric" placeholder="30"><label>Meal (pick all that apply)</label><div class="cf">'+MEALS.slice(1).map(function(m){return cchip('m',m)}).join('')+'</div><label>Diet</label><div class="cf">'+DIETS.map(function(d){return cchip('t',d)}).join('')+'</div><label>Allergy-free</label><div class="cf">'+ALLERGY.map(function(d){return cchip('t',d)}).join('')+'</div><label>Meat (if any)</label><div class="cf">'+MEATS.map(function(d){return cchip('x',d)}).join('')+'</div><label>Difficulty</label><div class="cf">'+DIFFS.map(function(d){return cchip('d',d)}).join('')+'</div><label for="g">Ingredients (one per line)</label><textarea class="inp" id="g" rows="4"></textarea><label for="s">Instructions (one step per line)</label><textarea class="inp" id="s" rows="4"></textarea><button class="btn full" style="margin-top:20px" data-act="post">Post recipe</button></div>'},
reels:function(){return '<div class="rwrap"><h2 class="rtitle">What’s cooking?</h2><div class="reels">'+R.map(reel).join('')+'</div></div>'},
profile:function(){var mine=R.filter(function(r){return r.user==='you'});return '<div class="stats"><span class="av" style="width:72px;height:72px;font-size:28px">Y</span><div><b>'+mine.length+'</b>Recipes</div><div><b>128</b>Followers</div><div><b>96</b>Following</div></div><div class="body" style="padding-top:0"><b>you</b><p style="color:var(--mute)">Cooking something new every week.</p></div>'+ptabs()+(S.ptab==='posts'?grid(mine,['Share your first recipe','Post a dish and it shows up on your profile.']):grid(R.filter(function(r){return S.saved.has(r.id)}),['Your cookbook is empty','Tap Save on any recipe and it lands here.']))}};
function exGrid(){var l=R.filter(match);return l.length?'<ul class="rl">'+l.map(function(r){return '<li><button class="row" data-act="open" data-id="'+r.id+'"><b>'+e(r.title)+'</b><small>by '+e(r.user)+', '+r.time+' min</small></button></li>'}).join('')+'</ul>':'<div class="empty"><h3>No matches</h3><p>Try a different search or filter.</p></div>'}
function detail(){var r=find(S.open),k=S.sv/r.serves;return '<div class="sheet"><button class="back" data-act="back" aria-label="Back">'+I('back')+'</button>'+ph(r)+'<div class="body"><h1>'+e(r.title)+'</h1><p style="color:var(--mute)">by '+e(r.user)+'</p>'+chips(r).replace('class="chips"','class="chips" style="padding-left:0"')+tagRow(r).replace('class="chips tags"','class="chips tags" style="padding-left:0"')+'<div class="stepper"><button data-act="sv" data-id="-1" aria-label="Fewer servings">−</button><b>'+S.sv+' servings</b><button data-act="sv" data-id="1" aria-label="More servings">+</button></div><h2>Ingredients</h2>'+r.ing.map(function(g,i){var on=S.chk.has(i);return '<button class="ing '+(on?'on':'')+'" data-act="chk" data-id="'+i+'" aria-pressed="'+on+'"><span class="bx">'+(on?'✓':'')+'</span><span class="q">'+(g[0]?fq(g[0]*k)+' '+g[1]:'')+'</span>'+e(g[2])+'</button>'}).join('')+'<h2 style="margin-top:22px">Steps</h2><ol class="steps">'+r.steps.map(function(s){return '<li>'+e(s)+'</li>'}).join('')+'</ol></div><div class="cta"><button class="btn full" data-act="cook">Start cooking</button></div></div>'}
function cook(){var r=find(S.open),n=r.steps.length,c=S.cook,done=c>=n;return '<div class="sheet cook" style="padding-bottom:0"><div class="bar"><i style="width:'+Math.min(100,(c+1)/n*100)+'%"></i></div><div class="txt">'+(done?'<h2>Dinner is ready.</h2><p>Share how it turned out when you’ve tasted it.</p>':'<p style="color:var(--mute);font-weight:700">Step '+(c+1)+' of '+n+'</p><h2>'+e(r.steps[c])+'</h2>')+'</div><div class="nv"><button class="ghost" data-act="prev">'+(c?'Back':'Exit')+'</button><button class="btn" data-act="next">'+(done?'Finish':'Next step')+'</button></div></div>'}
function nav(){var T=[['home','home','Home'],['explore','search','Explore'],['create','plus','Create'],['reels','play','What’s cooking?'],['profile','user','Profile']];return T.map(function(t){return '<button data-act="tab" data-id="'+t[0]+'" aria-label="'+t[2]+'" class="'+(S.tab===t[0]?'on ':'')+(t[0]==='create'?'mk':'')+'">'+I(t[1],S.tab===t[0]&&t[0]!=='create'&&t[0]!=='explore')+'</button>'}).join('')}
function render(){var rc=document.querySelector('.reels'),rs=rc?rc.scrollTop:0;document.body.classList.toggle('reelmode',S.tab==='reels');document.getElementById('view').innerHTML=V[S.tab]();rc=document.querySelector('.reels');if(rc)rc.scrollTop=rs;document.getElementById('nav').innerHTML=nav();document.getElementById('hdr').innerHTML=S.tab==='home'?'<button class="hb" data-act="inbox" aria-label="Messages">'+I('send')+(S.unread.size?'<i class="dot"></i>':'')+'</button>':'';document.getElementById('sheet').innerHTML=S.cook!==null?cook():S.open?detail():S.dm?(S.dm==='inbox'?inbox():chat(S.dm)):S.share?shareSheet():'';var ms=document.querySelector('.msgs');if(ms){ms.parentNode.scrollTop=ms.parentNode.scrollHeight}document.body.style.overflow=(S.open||S.dm||S.share)?'hidden':''}
function tog(set,id){set.has(id)?set.delete(id):set.add(id)}
document.addEventListener('click',function(ev){var b=ev.target.closest('[data-act]');if(!b)return;var a=b.dataset.act,id=b.dataset.id,n=+id;
if(a==='ctog'&&b.dataset.k==='d'){S.cd=S.cd===id?'':id;b.parentNode.querySelectorAll('.f').forEach(function(x){var on=x.dataset.id===S.cd;x.classList.toggle('on',on);x.setAttribute('aria-pressed',on)});return}
if(a==='ctog'){var st=b.dataset.k==='m'?S.cm:b.dataset.k==='x'?S.cx:S.ct;tog(st,id);b.classList.toggle('on');b.setAttribute('aria-pressed',st.has(id));return}
if(a==='tab'){S.tab=id;window.scrollTo(0,0)}
else if(a==='like')tog(S.liked,n);
else if(a==='save')tog(S.saved,n);
else if(a==='open'){S.open=n;S.sv=find(n).serves;S.chk=new Set()}
else if(a==='back')S.open=null;
else if(a==='fopen')S.fopen=!S.fopen;
else if(a==='ptab')S.ptab=id;
else if(a==='cmt'){S.dopen.add('c'+n);render();var ci=document.getElementById('ci'+n);if(ci){ci.scrollIntoView({block:'center'});ci.focus()}return}
else if(a==='cpost'){var ib=document.getElementById('ci'+n),cv=ib.value.trim();if(!cv)return;find(n).comments.push({u:'you',t:cv});S.dopen.add('c'+n);render();document.getElementById('ci'+n).focus();return}
else if(a==='share')S.share=n;
else if(a==='shclose')S.share=null;
else if(a==='sendto'){(MSG[id]=MSG[id]||[]).push({me:true,rid:S.share});S.sent.add(S.share+'|'+id)}
else if(a==='inbox')S.dm='inbox';
else if(a==='dmclose')S.dm=null;
else if(a==='chat'){S.dm=id;S.unread.delete(id)}
else if(a==='msend'){var mi=document.getElementById('mi'),mv=mi.value.trim();if(!mv)return;(MSG[id]=MSG[id]||[]).push({me:true,t:mv});render();document.getElementById('mi').focus();return}
else if(a==='meal')S.meal=id;
else if(a==='time')S.time=id;
else if(a==='diff')S.diff=id;
else if(a==='meat')tog(S.meats,id);
else if(a==='diet')tog(S.diets,id);
else if(a==='clr'){S.meal='All';S.time='Any';S.diff='Any';S.diets=new Set();S.meats=new Set()}
else if(a==='sv')S.sv=Math.max(1,S.sv+n);
else if(a==='chk')tog(S.chk,n);
else if(a==='cook')S.cook=0;
else if(a==='prev')S.cook=S.cook>0?S.cook-1:null;
else if(a==='next'){var len=find(S.open).steps.length;S.cook=S.cook>=len?null:S.cook+1}
else if(a==='post'){var t=document.getElementById('t').value.trim();if(!t){document.getElementById('t').focus();return}
var L=function(i){return document.getElementById(i).value.split('\n').map(function(x){return x.trim()}).filter(Boolean)};
R.unshift({id:Date.now(),title:t,user:'you',emoji:'🍽️',g:['#DDEB7A','#2F6B4E'],time:+document.getElementById('m').value||30,serves:2,diet:'Home cooked',comments:[],meats:Array.from(S.cx),diff:S.cd,meal:Array.from(S.cm),tags:Array.from(S.ct),likes:0,cap:'Fresh from my kitchen.',ing:L('g').map(function(x){return [0,'',x]}),steps:L('s')});S.cm=new Set();S.ct=new Set();S.cd='';S.cx=new Set();S.tab='home';window.scrollTo(0,0)}
render()});
document.addEventListener('toggle',function(ev){var k=ev.target.dataset&&ev.target.dataset.k;if(k){ev.target.open?S.dopen.add(k):S.dopen.delete(k)}},true);
document.addEventListener('keydown',function(ev){if(ev.key!=='Enter')return;var t=ev.target;if(t.dataset&&t.dataset.cin){t.parentNode.querySelector('[data-act=cpost]').click()}else if(t.id==='mi'){document.querySelector('[data-act=msend]').click()}});
document.addEventListener('input',function(ev){if(ev.target.id==='q'){S.q=ev.target.value;document.getElementById('grid').innerHTML=exGrid()}});
render();
</script>
</body>
</html>
